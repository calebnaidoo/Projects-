# Dependencies
node_modules/

# Environment variables (NEVER commit secrets)
.env

# SSL certificates (regenerate locally, never commit private keys)
certs/*.pem
certs/*.key
certs/*.crt

# Local "database" (file-based storage) - regenerated automatically at runtime
src/data/users.json

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
