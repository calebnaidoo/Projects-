<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — GLMS | TechMove</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <nav class="navbar">
        <div class="nav-inner">
            <a class="nav-brand" asp-controller="Home" asp-action="Index">
                <div class="nav-brand-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                        <path d="M2 17l10 5 10-5"/>
                        <path d="M2 12l10 5 10-5"/>
                    </svg>
                </div>
                <div class="nav-brand-text">
                    <span class="nav-brand-name">GLMS</span>
                    <span class="nav-brand-sub">TechMove Logistics</span>
                </div>
            </a>

            <ul class="nav-links">
                <li>
                    <a asp-controller="Home" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "nav-link--active" : "")">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        Dashboard
                    </a>
                </li>
                <li>
                    <a asp-controller="Clients" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clients" ? "nav-link--active" : "")">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        Clients
                    </a>
                </li>
                <li>
                    <a asp-controller="Contracts" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contracts" ? "nav-link--active" : "")">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10,9 9,9 8,9"/></svg>
                        Contracts
                    </a>
                </li>
                <li>
                    <a asp-controller="ServiceRequests" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceRequests" ? "nav-link--active" : "")">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
                        Service Requests
                    </a>
                </li>
            </ul>

            <div class="nav-end">
                <div class="nav-user">
                    <div class="nav-user-avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")</div>
                    <span class="nav-user-email">@User.Identity?.Name</span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    <button type="submit" class="btn-nav-logout">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16,17 21,12 16,7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        Sign out
                    </button>
                </form>
            </div>
        </div>
    </nav>
}

<main class="page-wrap @(User.Identity?.IsAuthenticated != true ? "page-wrap--auth" : "")">
    @if (TempData["Success"] != null)
    {
        <div class="toast toast--success">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20,6 9,17 4,12"/></svg>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast toast--error">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            @TempData["Error"]
        </div>
    }
    @RenderBody()
</main>

@if (User.Identity?.IsAuthenticated == true)
{
    <footer class="site-footer">
        <div class="footer-inner">
            <span>© 2026 TechMove Logistics · Global Logistics Management System</span>
            <span class="footer-tag">PROG7311 · Part 2</span>
        </div>
    </footer>
}

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
