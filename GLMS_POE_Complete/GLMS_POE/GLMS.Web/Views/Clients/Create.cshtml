@model Client
@{ ViewData["Title"] = "Add Client"; }
<div class="page-header"><div class="page-header-left"><h1>Add Client</h1></div><a asp-action="Index" class="btn btn--secondary">← Back</a></div>
<div class="form-card" style="max-width:700px">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:1rem"></div>
        <div class="form-grid">
            <div class="form-group form-group--full"><label asp-for="Name" class="form-label"></label><input asp-for="Name" placeholder="e.g. Global Freight Partners"/><span asp-validation-for="Name" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="ContactPerson" class="form-label"></label><input asp-for="ContactPerson" placeholder="Full name"/><span asp-validation-for="ContactPerson" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="Region" class="form-label"></label><select asp-for="Region"><option value="">— Select Region —</option><option>Africa</option><option>Asia-Pacific</option><option>Europe</option><option>Middle East</option><option>North America</option><option>South America</option></select><span asp-validation-for="Region" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" placeholder="contact@company.com"/><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" placeholder="+27-11-000-0000"/><span asp-validation-for="Phone" class="text-danger"></span></div>
        </div>
        <div class="form-actions"><button type="submit" class="btn btn--primary">Save Client</button><a asp-action="Index" class="btn btn--secondary">Cancel</a></div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
