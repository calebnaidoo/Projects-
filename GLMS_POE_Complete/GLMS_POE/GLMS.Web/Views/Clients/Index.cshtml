@model IEnumerable<Client>
@{ ViewData["Title"] = "Clients"; }
<div class="page-header"><div class="page-header-left"><h1>Clients</h1><p>@Model.Count() registered client@(Model.Count()!=1?"s":"")</p></div><a asp-action="Create" class="btn btn--primary">+ Add Client</a></div>
<div class="table-card">
    <div class="table-header"><span class="table-title">All Clients</span></div>
    @if(Model.Any()){
    <table><thead><tr><th>Name</th><th>Contact Person</th><th>Email</th><th>Region</th><th>Contracts</th><th>Actions</th></tr></thead>
    <tbody>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.ContactPerson</td><td style="color:var(--c-text2)">@c.Email</td><td>@c.Region</td><td><span class="badge badge--draft">@c.Contracts.Count</span></td>
    <td><div class="btn-group"><a asp-action="Details" asp-route-id="@c.Id" class="btn btn--secondary btn--sm">View</a><a asp-action="Edit" asp-route-id="@c.Id" class="btn btn--secondary btn--sm">Edit</a><a asp-action="Delete" asp-route-id="@c.Id" class="btn btn--danger btn--sm">Delete</a></div></td></tr>}</tbody></table>
    }else{<div class="empty"><div class="empty-icon">👥</div><div class="empty-text">No clients yet. <a asp-action="Create" class="link">Add one</a>.</div></div>}
</div>
