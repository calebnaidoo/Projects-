@model ContractFormViewModel
@{ ViewData["Title"] = "New Contract"; }
<div class="page-header"><div class="page-header-left"><h1>New Contract</h1></div><a asp-action="Index" class="btn btn--secondary">← Back</a></div>
<div class="form-card">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:1rem"></div>
        <div class="form-grid">
            <div class="form-group form-group--full"><label asp-for="Title" class="form-label"></label><input asp-for="Title" placeholder="e.g. Trans-Atlantic Freight Agreement 2026"/><span asp-validation-for="Title" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="ClientId" class="form-label">Client</label><select asp-for="ClientId" asp-items="Model.ClientList"><option value="">— Select Client —</option></select><span asp-validation-for="ClientId" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="ServiceLevel" class="form-label"></label><select asp-for="ServiceLevel" asp-items="Html.GetEnumSelectList<ServiceLevel>()"></select></div>
            <div class="form-group"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" type="date"/><span asp-validation-for="StartDate" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" type="date"/><span asp-validation-for="EndDate" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ContractStatus>()"></select></div>
            <div class="form-group"><label asp-for="ContractValueUSD" class="form-label"></label><input asp-for="ContractValueUSD" type="number" step="0.01" min="0" placeholder="0.00"/></div>
            <div class="form-group form-group--full"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" placeholder="Optional notes…"></textarea></div>
            <div class="form-group form-group--full"><label class="form-label">Signed Agreement (PDF only, max 10 MB)</label>
                <div class="file-drop"><input type="file" name="SignedAgreement" accept=".pdf"/><div class="file-drop-label"><strong>Browse</strong> or drag &amp; drop PDF here<div class="file-drop-name">No file chosen</div></div></div></div>
        </div>
        <div class="form-actions"><button type="submit" class="btn btn--primary">Create Contract</button><a asp-action="Index" class="btn btn--secondary">Cancel</a></div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
